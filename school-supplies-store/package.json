{
  "name": "school-supplies-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "db:migrate": "wrangler d1 migrations apply school-supplies-store --local",
    "db:seed": "wrangler d1 execute school-supplies-store --local --file scripts/seed.sql",
    "admin:create": "node scripts/create-admin.mjs",
    "test:api": "node --test --test-concurrency=1 tests/api.test.mjs",
    "test:ui": "playwright test",
    "test:e2e": "node tests/run-local.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "i18next": "^25.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "wrangler": "^4.45.0"
  }
}
