{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maktabati",
  "version": "0.1.0",
  "identifier": "com.maktabati.testing",
  "build": { "frontendDist": "../empty" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": { "capabilities": [], "csp": "default-src 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Maktabati private testing",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Arabic"],
        "displayLanguageSelector": true
      }
    },
    "android": { "minSdkVersion": 24 }
  }
}
